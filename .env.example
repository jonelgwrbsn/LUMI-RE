# Server Port (defaults to 3000)
PORT=3000

# Public Base URL used when generating shareable QR code links
# Defaults to http://localhost:3000 in local development
APP_URL="http://localhost:3000"

# Optional: Gemini API Key for neural optical calibration in the Super-Resolution modal.
# If omitted, Lumière automatically uses its built-in Lanczos/unsharp-mask optical super-resolution engine.
GEMINI_API_KEY=""

